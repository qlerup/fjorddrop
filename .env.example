APP_PORT=8102
BIND_ADDRESS=0.0.0.0
DATA_DIR=/opt/fjorddrop/data
SHARED_DIR=/opt/fjorddrop/shared
RECEIVED_DIR=/opt/fjorddrop/received
PUID=1000
PGID=1000
# Standalone only: at least 16 random characters. Hub installations use Hub SSO.
ADMIN_PASSWORD=
PUBLIC_URL=
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
MAX_UPLOAD_GB=100
# Coturn is installed automatically. Blank IP: discover at startup.
# Forward TCP+UDP TURN_PORT and UDP TURN_MIN_PORT-TURN_MAX_PORT to this host.
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
